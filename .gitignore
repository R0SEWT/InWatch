# Regla del repo: regenerables gitignored, reportes versionados.
# Las excepciones van con `!` y de forma explícita — nunca por accidente.

# ── Datos regenerables ────────────────────────────────────────────────────────
data/bronze/
data/silver/
data/gold/
data/raw/
# Espejo local de bocho (`fuentes sync`) y caché de sha del catálogo.
data/lake/
data/.cache/
*.parquet
*.duckdb

# El registro canónico ES memoria científica: se versiona aunque viva cerca de datos.
!registry/canonical_numbers.json

# Insumos curados: chicos, públicos y no regenerables con un comando. Misma política que
# el gazetteer de estaciones del repo de origen. Se versionan con `!` explícito.
!data/curado/
!data/curado/**

# ── Reportes: versionados ─────────────────────────────────────────────────────
# (no se ignora nada de analysis/ ni de experiments/*/README.md)

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
.venv-*/
*.egg-info/
dist/
build/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# ── marimo ────────────────────────────────────────────────────────────────────
__marimo__/
.marimo.toml

# ── Agentes ───────────────────────────────────────────────────────────────────
.claude/settings.local.json
.playwright-mcp/
.beads/embeddeddolt/
.beads/backup/
.beads/interactions.jsonl
.beads/export-state.json
.beads/last-touched
.beads/.local_version
.beads/*.lock
.beads/.env

# ── Sistema ───────────────────────────────────────────────────────────────────
.DS_Store
*.log

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Worktrees de agentes: repos embebidos, nunca se commitean
.claude/worktrees/

# Andamiaje que Gas Town inyecta en el sandbox de cada polecat. No es trabajo: se
# regenera en cada spawn. Sin ignorarlo, el predicado de limpieza lee el sandbox como
# `has_uncommitted`, el polecat entra en recovery y el rig se queda sin capacidad —
# con la cola llena y nada corriendo.
.runtime/
CLAUDE.local.md
.claude/commands/
